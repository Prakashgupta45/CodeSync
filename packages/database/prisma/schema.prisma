generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  ACTIVE
  CLOSED
}

enum RoomMemberRole {
  OWNER
  PARTICIPANT
  VIEWER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions         Session[]
  refreshTokens    RefreshToken[]
  ownedRooms       Room[]         @relation("OwnedRooms")
  roomMemberships  RoomMember[]   @relation("RoomMemberships")
  chatMessages     ChatMessage[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String   @unique
  familyId    String   @default(uuid())
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Room {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  owner     User       @relation("OwnedRooms", fields: [ownerId], references: [id], onDelete: Cascade)
  language  String
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members      RoomMember[]
  document     RoomDocument?
  chatMessages ChatMessage[]

  @@index([ownerId])
  @@index([status])
  @@map("rooms")
}

model RoomMember {
  id       String         @id @default(uuid())
  roomId   String
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("RoomMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role     RoomMemberRole @default(PARTICIPANT)
  joinedAt DateTime       @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

model RoomDocument {
  id        String   @id @default(uuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content   String   @default("")
  state     Bytes?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_documents")
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_messages")
}
