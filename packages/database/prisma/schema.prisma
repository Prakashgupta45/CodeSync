generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  ACTIVE
  CLOSED
}

enum RoomMemberRole {
  OWNER
  PARTICIPANT
  VIEWER
}

enum InterviewStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InterviewActionType {
  START_INTERVIEW
  ASK_APPROACH
  ANALYZE_CODE
  ASK_COMPLEXITY
  DEBUG_ERROR
  FOLLOW_UP
  EVALUATE
  FINAL_REPORT
}

enum SenderType {
  AI_INTERVIEWER
  CANDIDATE
  SYSTEM
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  status        String         @default("ACTIVE")
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions            Session[]
  refreshTokens       RefreshToken[]
  ownedRooms          Room[]         @relation("OwnedRooms")
  roomMemberships     RoomMember[]   @relation("RoomMemberships")
  chatMessages        ChatMessage[]
  aiMessages          AiMessage[]
  ownedInterviews     Interview[]    @relation("OwnedInterviews")
  candidateInterviews Interview[]    @relation("CandidateInterviews")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String   @unique
  familyId    String   @default(uuid())
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Room {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  owner     User       @relation("OwnedRooms", fields: [ownerId], references: [id], onDelete: Cascade)
  language  String
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members      RoomMember[]
  document     RoomDocument?
  chatMessages ChatMessage[]
  aiMessages   AiMessage[]
  interviews   Interview[]

  @@index([ownerId])
  @@index([status])
  @@map("rooms")
}

model RoomMember {
  id       String         @id @default(uuid())
  roomId   String
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("RoomMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role     RoomMemberRole @default(PARTICIPANT)
  joinedAt DateTime       @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

model RoomDocument {
  id        String   @id @default(uuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content   String   @default("")
  state     Bytes?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_documents")
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model AiMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  response  String
  action    String   @default("CHAT")
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("ai_messages")
}

model Problem {
  id            String   @id @default(uuid())
  title         String
  description   String
  difficulty    String   @default("MEDIUM")
  constraints   String
  examples      String
  expectedInput String?
  expectedOutput String?
  starterCode   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interviews Interview[]

  @@map("problems")
}

model Interview {
  id           String          @id @default(uuid())
  roomId       String
  room         Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User            @relation("OwnedInterviews", fields: [ownerId], references: [id], onDelete: Cascade)
  candidateId  String?
  candidate    User?           @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: SetNull)
  problemId    String?
  problem      Problem?        @relation(fields: [problemId], references: [id], onDelete: SetNull)
  title        String
  candidateName String?
  candidateEmail String?
  jobRole      String?         @default("SDE")
  status       InterviewStatus @default(DRAFT)
  language     String          @default("javascript")
  duration     Int             @default(45)
  instructions String?
  startedAt    DateTime?
  completedAt  DateTime?
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  messages InterviewMessage[]
  events   InterviewEvent[]
  report   InterviewReport?

  @@index([roomId])
  @@index([ownerId])
  @@index([candidateId])
  @@index([status])
  @@map("interviews")
}

model InterviewMessage {
  id          String              @id @default(uuid())
  interviewId String
  interview   Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  senderType  SenderType
  senderId    String?
  content     String
  action      InterviewActionType?
  createdAt   DateTime            @default(now())

  @@index([interviewId, createdAt])
  @@map("interview_messages")
}

model InterviewEvent {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  eventType   String
  payload     String?
  createdAt   DateTime  @default(now())

  @@index([interviewId, createdAt])
  @@map("interview_events")
}

model InterviewReport {
  id                  String    @id @default(uuid())
  interviewId         String    @unique
  interview           Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore        Int
  problemSolvingScore Int
  algorithmScore      Int
  codeQualityScore    Int
  debuggingScore      Int
  complexityScore     Int
  communicationScore  Int
  strengths           String
  weaknesses          String
  improvements        String
  importantEvents     String
  assessment          String
  recommendedNextSteps String
  createdAt           DateTime  @default(now())

  @@map("interview_reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String
  actorEmail String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
