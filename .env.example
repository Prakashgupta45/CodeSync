# System Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesync_db?schema=public

# Cache & Queue Configuration (Redis)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Minimum 32 random characters for production)
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security (false for local HTTP dev, true for HTTPS production)
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Phase 6 AI Assistant Configuration
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Phase 7 WebRTC STUN / TURN Server Configuration
NEXT_PUBLIC_STUN_SERVER_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_SERVER_URL=turn:your-turn-server-domain:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password
